{
  "name": "mailflow-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "tsx scripts/test-subscribe-api.ts",
    "db:setup": "tsx --env-file=.env scripts/setup-tables.ts",
    "db:reset": "tsx --env-file=.env scripts/setup-tables.ts --reset",
    "worker": "tsx --env-file=.env worker/index.ts",
    "seed": "tsx --env-file=.env scripts/seed-contacts.ts",
    "generate-csv": "tsx scripts/generate-contacts-csv.ts",
    "unsub-link": "tsx --env-file=.env scripts/unsubscribe-link.ts",
    "simulate": "tsx --env-file=.env scripts/simulate-activity.ts",
    "seed:clean": "tsx --env-file=.env scripts/seed-clean.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1155.0",
    "@base-ui/react": "^1.9.0",
    "@xyflow/react": "^12.12.0",
    "appwrite": "^28.3.0",
    "bullmq": "^6.3.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "node-appwrite": "^29.4.0",
    "nodemailer": "^10.1.2",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
